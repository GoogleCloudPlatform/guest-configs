#
# Honor udev ENV{ID_NET_MANAGED_BY}="unmanaged" from 75-gce-network.rules on
# systemd-networkd versions 243-254 (prior to native ID_NET_MANAGED_BY support
# added in v255) so bare-metal mlx5_core RoCE PFs, SR-IOV VFs, and switchdev VF
# representors (mlx5e_rep) remain unmanaged while VM pass-through VFs and
# managed PFs remain managed.
#
# Note: [Match] Property= requires systemd >= v243. Packaging excludes this file
# on older systemd (< v243, e.g. Ubuntu 18.04 / EL8) so Driver= cannot match
# all mlx5_core interfaces unconditionally when Property= is unsupported.

[Match]
Driver=mlx5_core mlx5e_rep
Property=ID_NET_MANAGED_BY=unmanaged

[Link]
RequiredForOnline=no
Unmanaged=yes
